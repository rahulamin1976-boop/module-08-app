{
  "name": "module-08-app-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "test": "node --test tests/config.test.js tests/server.test.js tests/middleware/*.test.js tests/security/oauth-crypto.test.js tests/integrations/*.test.js tests/services/*.test.js tests/routes/*.test.js",
    "test:db": "node --env-file-if-exists=.env --test tests/db/*.test.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "pg": "8.23.1"
  }
}
